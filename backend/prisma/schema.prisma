generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TICKET_REQUESTER
  SYSTEM_OWNER
  PROGRAMMING_HEAD
  PROJECT_MANAGER
  DEVELOPER
  QA
  SENIOR_MANAGEMENT
}

enum TicketStatus {
  DRAFT
  NEW
  AWAITING_INFO
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  SCHEDULED
  IN_PROGRESS
  AWAITING_TESTING
  AWAITING_OWNER_APPROVAL
  COMPLETED
  CLOSED
  /// Involuntary: waiting on a prerequisite, another team, or missing input.
  BLOCKED
  /// A deliberate pause by leadership.
  ON_HOLD
}

enum TicketType {
  MODIFICATION
  NEW_FEATURE
  BUG_FIX
  UI_IMPROVEMENT
  PERFORMANCE
  REPORT_DASHBOARD
  USER_PERMISSIONS
  API_INTEGRATION
  EMERGENCY
  TECHNICAL_CONSULTATION
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  DEFERRED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum NotificationType {
  TICKET_CREATED
  INFO_REQUESTED
  TICKET_APPROVED
  TICKET_REJECTED
  TICKET_ASSIGNED
  STATUS_CHANGED
  COMMENT_ADDED
  DEADLINE_APPROACHING
  TICKET_DELAYED
  EXECUTION_COMPLETED
  CLOSURE_APPROVAL_REQUESTED
  TASK_ASSIGNED
  BUG_ASSIGNED
  TEST_CASE_FAILED
}

enum TaskStatus {
  NEW
  IN_PROGRESS
  COMPLETED
}

enum CommentVisibility {
  PUBLIC
  INTERNAL
}

/// How two tickets relate. Only BLOCKS is a constraint — it gates `start` and is
/// the only kind checked for cycles. The others are navigation aids: they say
/// "look at this too", not "you may not proceed".
enum TicketDependencyType {
  BLOCKS
  RELATES_TO
  DUPLICATES
}

enum SignupRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Authoring state. Separate from TestResult on purpose: "written but not yet
/// run" and "still being drafted" are different things, and archiving a stale
/// case must not destroy its last result.
enum TestState {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Current execution result. NOT_RUN is the default for a freshly published case.
enum TestResult {
  NOT_RUN
  PASS
  FAIL
  BLOCKED
  SKIPPED
}

/// Impact, judged by whoever found it. Scheduling urgency stays in `Priority`.
enum BugSeverity {
  BLOCKER
  CRITICAL
  MAJOR
  MINOR
  TRIVIAL
}

enum BugStatus {
  OPEN
  IN_PROGRESS
  FIXED
  VERIFIED
  CLOSED
  WONT_FIX
  DUPLICATE
}

model Company {
  id            String        @id @default(uuid())
  name          String
  nameAr        String?
  domain        String?
  logoUrl       String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  departments   Department[]
  systems       System[]
  users         User[]
  userCompanies UserCompany[]
  tickets       Ticket[]
  testSuites    TestSuite[]
  bugs          Bug[]
}

model Department {
  id        String   @id @default(uuid())
  name      String
  nameAr    String?
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model System {
  id          String       @id @default(uuid())
  name        String
  nameAr      String?
  domain      String?
  description String?
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id])
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tickets     Ticket[]
  userSystems UserSystem[]
  testSuites  TestSuite[]
  bugs        Bug[]
}

model User {
  id                     String                  @id @default(uuid())
  email                  String                  @unique
  password               String?
  firstName              String
  lastName               String
  role                   UserRole
  companyId              String?
  company                Company?                @relation(fields: [companyId], references: [id])
  departmentId           String?
  department             Department?             @relation(fields: [departmentId], references: [id])
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  systems                UserSystem[]
  ticketsCreated         Ticket[]                @relation("TicketCreator")
  ticketsOwned           Ticket[]                @relation("TicketOwner")
  assignments            TicketAssignment[]
  approvals              TicketApproval[]
  comments               TicketComment[]
  notifications          Notification[]
  invitationsSent        EmailInvitation[]       @relation("InvitationSender")
  invitationReceived     EmailInvitation?        @relation("InvitationReceiver")
  passwordResetTokens    PasswordResetToken[]
  companies              UserCompany[]
  auditLogs              AuditLog[]
  signupRequestsReviewed SignupRequest[]
  tasksAssigned          TicketTask[]            @relation("TaskAssignee")
  tasksCreated           TicketTask[]            @relation("TaskCreator")
  statusChanges          TicketStatusHistory[]   @relation("StatusHistoryChanger")
  dependenciesCreated    TicketDependency[]      @relation("DependencyCreator")
  suitesOwned            TestSuite[]             @relation("SuiteOwner")
  suiteTicketLinks       TestSuiteTicket[]       @relation("SuiteTicketLinker")
  casesAssigned          TestCase[]              @relation("CaseAssignee")
  casesRun               TestCase[]              @relation("CaseRunner")
  caseResultChanges      TestCaseResultHistory[] @relation("CaseResultChanger")
  bugsReported           Bug[]                   @relation("BugReporter")
  bugsAssigned           Bug[]                   @relation("BugAssignee")
  bugStatusChanges       BugStatusHistory[]      @relation("BugStatusChanger")
}

model UserSystem {
  userId    String
  systemId  String
  user      User     @relation(fields: [userId], references: [id])
  system    System   @relation(fields: [systemId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, systemId])
}

model Ticket {
  id                   String                @id @default(uuid())
  title                String
  description          String
  reason               String
  expectedOutcome      String
  businessImpact       String
  hasFinancialLoss     Boolean               @default(false)
  financialLossDetails String?
  status               TicketStatus          @default(DRAFT)
  type                 TicketType
  priority             Priority?
  finalPriority        Priority?
  suggestedDeadline    DateTime?
  scheduledStart       DateTime?
  estimatedDeadline    DateTime?
  estimatedHours       Int?
  difficultyLevel      Int?
  /// Rollups over this ticket's tasks. Single writer: TaskRollupService.
  tasksEstimatedHours  Int?
  tasksWeightTotal     Int?
  /// Stamped by changeStatus. startedAt is the first move into IN_PROGRESS and
  /// is never reset; completedAt clears if the ticket moves back out of COMPLETED.
  startedAt            DateTime?
  completedAt          DateTime?
  needsUiUx            Boolean               @default(false)
  needsBackend         Boolean               @default(false)
  needsFrontend        Boolean               @default(false)
  needsTesting         Boolean               @default(false)
  needsDeployment      Boolean               @default(false)
  adminNotes           String?
  closureNotes         String?
  isArchived           Boolean               @default(false)
  coverImageUrl        String?
  ticketNumber         Int                   @unique @default(autoincrement())
  creatorId            String
  creator              User                  @relation("TicketCreator", fields: [creatorId], references: [id])
  systemOwnerId        String?
  systemOwner          User?                 @relation("TicketOwner", fields: [systemOwnerId], references: [id])
  systemId             String
  system               System                @relation(fields: [systemId], references: [id])
  companyId            String
  company              Company               @relation(fields: [companyId], references: [id])
  relatedTicketId      String?
  relatedTicket        Ticket?               @relation("RelatedTickets", fields: [relatedTicketId], references: [id])
  relatedTickets       Ticket[]              @relation("RelatedTickets")
  /// Why the ticket is BLOCKED or ON_HOLD. Cleared on resume. The status to
  /// return to is read out of TicketStatusHistory rather than stored, so it
  /// cannot drift when force-status is used.
  pauseReason          String?
  blockedByTicketId    String?
  blockedByTicket      Ticket?               @relation("BlockedBy", fields: [blockedByTicketId], references: [id])
  blockedTickets       Ticket[]              @relation("BlockedBy")
  templateId           String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  comments             TicketComment[]
  attachments          TicketAttachment[]
  statusHistory        TicketStatusHistory[]
  assignments          TicketAssignment[]
  approvals            TicketApproval[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  tasks                TicketTask[]
  blocking             TicketDependency[]    @relation("BlockingTicket")
  blockedBy            TicketDependency[]    @relation("BlockedTicket")
  testCases            TestCase[]
  bugs                 Bug[]                 @relation("BugTicket")
  suiteLinks           TestSuiteTicket[]
}

/// "This ticket cannot start until that one is done."
///
/// Replaces Ticket.relatedTicketId, which said only "related" — no direction, no
/// meaning, and nothing read it. Edges are checked for cycles before they are
/// written, so the graph stays a DAG.
model TicketDependency {
  id               String               @id @default(uuid())
  blockingTicketId String
  blockingTicket   Ticket               @relation("BlockingTicket", fields: [blockingTicketId], references: [id], onDelete: Cascade)
  blockedTicketId  String
  blockedTicket    Ticket               @relation("BlockedTicket", fields: [blockedTicketId], references: [id], onDelete: Cascade)
  type             TicketDependencyType @default(BLOCKS)
  createdById      String
  createdBy        User                 @relation("DependencyCreator", fields: [createdById], references: [id])
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([blockingTicketId, blockedTicketId])
  @@index([blockedTicketId])
}

model TicketComment {
  id          String             @id @default(uuid())
  content     String
  visibility  CommentVisibility  @default(PUBLIC)
  ticketId    String
  ticket      Ticket             @relation(fields: [ticketId], references: [id])
  authorId    String
  author      User               @relation(fields: [authorId], references: [id])
  mentions    String[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  attachments TicketAttachment[]
}

model TicketAttachment {
  id           String         @id @default(uuid())
  fileName     String
  fileSize     Int
  mimeType     String
  url          String
  ticketId     String?
  ticket       Ticket?        @relation(fields: [ticketId], references: [id])
  commentId    String?
  comment      TicketComment? @relation(fields: [commentId], references: [id])
  taskId       String?
  task         TicketTask?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  testCaseId   String?
  testCase     TestCase?      @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  bugId        String?
  bug          Bug?           @relation(fields: [bugId], references: [id], onDelete: Cascade)
  testStepId   String?
  testStep     TestStep?      @relation(fields: [testStepId], references: [id], onDelete: Cascade)
  /// Suite-level reference docs covering the whole suite (any file type).
  suiteId      String?
  suite        TestSuite?     @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  uploadedById String
  createdAt    DateTime       @default(now())
}

model TicketStatusHistory {
  id          String        @id @default(uuid())
  ticketId    String
  ticket      Ticket        @relation(fields: [ticketId], references: [id])
  fromStatus  TicketStatus?
  toStatus    TicketStatus
  changedById String
  changedBy   User          @relation("StatusHistoryChanger", fields: [changedById], references: [id])
  reason      String?
  createdAt   DateTime      @default(now())
}

/// Who is working a ticket. A membership row per developer, not an append-only
/// log — assignment history lives in AuditLog. Exactly one active row per ticket
/// carries isLead, enforced by a partial unique index.
model TicketAssignment {
  id                String    @id @default(uuid())
  ticketId          String
  ticket            Ticket    @relation(fields: [ticketId], references: [id])
  developerId       String
  developer         User      @relation(fields: [developerId], references: [id])
  estimatedHours    Int?
  startDate         DateTime?
  estimatedDeadline DateTime?
  isActive          Boolean   @default(true)
  /// The lead owns the ticket-level transitions; everyone else works their tasks.
  isLead            Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([ticketId, developerId])
  @@index([ticketId, isActive])
}

model TicketApproval {
  id         String   @id @default(uuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
  approverId String
  approver   User     @relation(fields: [approverId], references: [id])
  decision   String
  notes      String?
  conditions String?
  createdAt  DateTime @default(now())
}

model EmailInvitation {
  id         String           @id @default(uuid())
  email      String
  role       UserRole
  token      String           @unique @default(uuid())
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime
  senderId   String
  sender     User             @relation("InvitationSender", fields: [senderId], references: [id])
  receiverId String?          @unique
  receiver   User?            @relation("InvitationReceiver", fields: [receiverId], references: [id])
  companyId  String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  ticketId  String?
  ticket    Ticket?          @relation(fields: [ticketId], references: [id])
  metadata  Json?
  createdAt DateTime         @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  ticketId  String?
  ticket    Ticket?  @relation(fields: [ticketId], references: [id])
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model TicketTemplate {
  id          String     @id @default(uuid())
  name        String
  nameAr      String?
  domain      String?
  type        TicketType
  description String?
  fields      Json?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model UserCompany {
  userId    String
  companyId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, companyId])
}

model SignupRequest {
  id           String              @id @default(uuid())
  firstName    String
  lastName     String
  email        String              @unique
  status       SignupRequestStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?               @relation(fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  createdAt    DateTime            @default(now())
}

model TicketTask {
  id              String             @id @default(cuid())
  ticketId        String
  ticket          Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  assignedToId    String
  assignedTo      User               @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdById     String
  createdBy       User               @relation("TaskCreator", fields: [createdById], references: [id])
  status          TaskStatus         @default(NEW)
  dueDate         DateTime?
  estimatedHours  Int?
  /// 1–5, the same scale as Ticket.difficultyLevel (req.md §9 «مستوى الصعوبة»).
  difficultyLevel Int?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  attachments     TicketAttachment[]

  @@index([ticketId, status])
  @@index([assignedToId, status])
}

/// A named group of test cases hanging off exactly one system, plus any number
/// of tickets it exercises. Scope (who may see it) comes from the system and
/// company, so the existing ticket scoping rules apply unchanged.
model TestSuite {
  id          String    @id @default(uuid())
  suiteNumber Int       @unique @default(autoincrement())
  title       String
  description String?
  systemId    String
  system      System    @relation(fields: [systemId], references: [id])
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  ownerId     String
  owner       User      @relation("SuiteOwner", fields: [ownerId], references: [id])
  state       TestState @default(DRAFT)
  isArchived  Boolean   @default(false)
  /// Rollup over this suite's ACTIVE cases. Single writer: TestRollupService.
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  cases       TestCase[]
  ticketLinks TestSuiteTicket[]
  bugs        Bug[]
  attachments TicketAttachment[]

  @@index([systemId, state])
  @@index([companyId])
}

/// "This suite exercises that ticket." A suite covering authentication links
/// both the backend and the frontend auth tickets.
model TestSuiteTicket {
  suiteId    String
  suite      TestSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  ticketId   String
  ticket     Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  linkedById String
  linkedBy   User      @relation("SuiteTicketLinker", fields: [linkedById], references: [id])
  createdAt  DateTime  @default(now())

  @@id([suiteId, ticketId])
  @@index([ticketId])
}

model TestCase {
  id             String     @id @default(uuid())
  caseNumber     Int        @unique @default(autoincrement())
  suiteId        String
  suite          TestSuite  @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  /// The one ticket this case is primarily about. The suite may link more.
  ticketId       String?
  ticket         Ticket?    @relation(fields: [ticketId], references: [id])
  assignedToId   String?
  assignedTo     User?      @relation("CaseAssignee", fields: [assignedToId], references: [id])
  title          String
  description    String?
  preconditions  String?
  expectedResult String
  actualResult   String?
  state          TestState  @default(DRAFT)
  lastResult     TestResult @default(NOT_RUN)
  lastRunAt      DateTime?
  lastRunById    String?
  lastRunBy      User?      @relation("CaseRunner", fields: [lastRunById], references: [id])
  /// Manual ordering inside the suite panel.
  order          Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  steps         TestStep[]              @relation("CaseSteps")
  bugs          Bug[]
  resultHistory TestCaseResultHistory[]
  /// Case-level files only — step screenshots hang off TestStep.attachments.
  attachments   TicketAttachment[]

  @@index([suiteId, order])
  @@index([ticketId])
  @@index([assignedToId, lastResult])
}

/// Ordered step row — shared shape for test-case execution steps and bug repro
/// steps. Exactly one of testCaseId / bugId is set. Attachments (typically
/// screenshots) belong to the step, not the parent case/bug.
model TestStep {
  id         String    @id @default(uuid())
  testCaseId String?
  testCase   TestCase? @relation("CaseSteps", fields: [testCaseId], references: [id], onDelete: Cascade)
  bugId      String?
  bug        Bug?      @relation("BugSteps", fields: [bugId], references: [id], onDelete: Cascade)
  order      Int       @default(0)
  body       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  attachments TicketAttachment[]

  @@index([testCaseId, order])
  @@index([bugId, order])
}

/// Mirrors TicketStatusHistory: every result change is auditable.
model TestCaseResultHistory {
  id          String      @id @default(uuid())
  testCaseId  String
  testCase    TestCase    @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  fromResult  TestResult?
  toResult    TestResult
  changedById String
  changedBy   User        @relation("CaseResultChanger", fields: [changedById], references: [id])
  note        String?
  createdAt   DateTime    @default(now())

  @@index([testCaseId, createdAt])
}

model Bug {
  id               String      @id @default(uuid())
  bugNumber        Int         @unique @default(autoincrement())
  /// Null when the bug was filed straight from the bugs page.
  testCaseId       String?
  testCase         TestCase?   @relation(fields: [testCaseId], references: [id])
  suiteId          String?
  suite            TestSuite?  @relation(fields: [suiteId], references: [id])
  /// Denormalised on purpose: a standalone bug has no case to inherit scope
  /// from, and the list page filters on both constantly.
  systemId         String
  system           System      @relation(fields: [systemId], references: [id])
  companyId        String
  company          Company     @relation(fields: [companyId], references: [id])
  /// Set by "promote to ticket".
  ticketId         String?
  ticket           Ticket?     @relation("BugTicket", fields: [ticketId], references: [id])
  reportedById     String
  reportedBy       User        @relation("BugReporter", fields: [reportedById], references: [id])
  assignedToId     String?
  assignedTo       User?       @relation("BugAssignee", fields: [assignedToId], references: [id])
  title            String
  description      String
  expectedBehavior String?
  actualBehavior   String?
  environment      String?
  severity         BugSeverity
  priority         Priority?
  status           BugStatus   @default(OPEN)
  detectedAt       DateTime    @default(now())
  resolvedAt       DateTime?
  isArchived       Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  steps         TestStep[]         @relation("BugSteps")
  attachments   TicketAttachment[]
  statusHistory BugStatusHistory[]

  @@index([status, severity])
  @@index([systemId])
  @@index([assignedToId, status])
  @@index([ticketId])
  @@index([testCaseId])
}

model BugStatusHistory {
  id          String     @id @default(uuid())
  bugId       String
  bug         Bug        @relation(fields: [bugId], references: [id], onDelete: Cascade)
  fromStatus  BugStatus?
  toStatus    BugStatus
  changedById String
  changedBy   User       @relation("BugStatusChanger", fields: [changedById], references: [id])
  note        String?
  createdAt   DateTime   @default(now())

  @@index([bugId, createdAt])
}
