{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": ["dotenv/config", "<rootDir>/e2e.env.js"],
  "moduleNameMapper": {
    "^uuid$": "<rootDir>/uuid-mock.js"
  },
  "testTimeout": 120000,
  "maxWorkers": 1
}
