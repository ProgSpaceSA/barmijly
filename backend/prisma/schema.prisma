generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TICKET_REQUESTER
  SYSTEM_OWNER
  PROGRAMMING_HEAD
  PROJECT_MANAGER
  DEVELOPER
  QA
  SENIOR_MANAGEMENT
}

enum TicketStatus {
  DRAFT
  NEW
  AWAITING_INFO
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  SCHEDULED
  IN_PROGRESS
  AWAITING_TESTING
  AWAITING_OWNER_APPROVAL
  COMPLETED
  CLOSED
  /// Involuntary: waiting on a prerequisite, another team, or missing input.
  BLOCKED
  /// A deliberate pause by leadership.
  ON_HOLD
}

enum TicketType {
  MODIFICATION
  NEW_FEATURE
  BUG_FIX
  UI_IMPROVEMENT
  PERFORMANCE
  REPORT_DASHBOARD
  USER_PERMISSIONS
  API_INTEGRATION
  EMERGENCY
  TECHNICAL_CONSULTATION
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  DEFERRED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum NotificationType {
  TICKET_CREATED
  INFO_REQUESTED
  TICKET_APPROVED
  TICKET_REJECTED
  TICKET_ASSIGNED
  STATUS_CHANGED
  COMMENT_ADDED
  DEADLINE_APPROACHING
  TICKET_DELAYED
  EXECUTION_COMPLETED
  CLOSURE_APPROVAL_REQUESTED
  TASK_ASSIGNED
  BUG_ASSIGNED
  TEST_CASE_FAILED
  REQUIREMENT_RAISED
  REQUIREMENT_ASSIGNED
  TOOL_REQUESTED
  TOOL_DECIDED
  FEEDBACK_CREATED
  FEEDBACK_UPDATED
}

enum TaskStatus {
  NEW
  IN_PROGRESS
  COMPLETED
}

enum CommentVisibility {
  PUBLIC
  INTERNAL
}

/// How two tickets relate. Only BLOCKS is a constraint — it gates `start` and is
/// the only kind checked for cycles. The others are navigation aids: they say
/// "look at this too", not "you may not proceed".
enum TicketDependencyType {
  BLOCKS
  RELATES_TO
  DUPLICATES
}

enum SignupRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Authoring state. Separate from TestResult on purpose: "written but not yet
/// run" and "still being drafted" are different things, and archiving a stale
/// case must not destroy its last result.
enum TestState {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Current execution result. NOT_RUN is the default for a freshly published case.
enum TestResult {
  NOT_RUN
  PASS
  FAIL
  BLOCKED
  SKIPPED
}

/// Impact, judged by whoever found it. Scheduling urgency stays in `Priority`.
enum BugSeverity {
  BLOCKER
  CRITICAL
  MAJOR
  MINOR
  TRIVIAL
}

enum BugStatus {
  OPEN
  IN_PROGRESS
  FIXED
  VERIFIED
  CLOSED
  WONT_FIX
  DUPLICATE
}

model Company {
  id            String        @id @default(uuid())
  name          String
  nameAr        String?
  domain        String?
  logoUrl       String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  departments   Department[]
  systems       System[]
  users         User[]
  userCompanies UserCompany[]
  tickets       Ticket[]
  testSuites    TestSuite[]
  bugs          Bug[]
  meetings      Meeting[]
  requirements  Requirement[]
}

model Department {
  id        String   @id @default(uuid())
  name      String
  nameAr    String?
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model System {
  id           String          @id @default(uuid())
  name         String
  nameAr       String?
  domain       String?
  description  String?
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id])
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tickets      Ticket[]
  userSystems  UserSystem[]
  testSuites   TestSuite[]
  bugs         Bug[]
  meetingLinks MeetingSystem[]
  requirements Requirement[]
}

model User {
  id                       String                     @id @default(uuid())
  email                    String                     @unique
  password                 String?
  firstName                String
  lastName                 String
  role                     UserRole
  companyId                String?
  company                  Company?                   @relation(fields: [companyId], references: [id])
  departmentId             String?
  department               Department?                @relation(fields: [departmentId], references: [id])
  isActive                 Boolean                    @default(true)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  systems                  UserSystem[]
  ticketsCreated           Ticket[]                   @relation("TicketCreator")
  ticketsOwned             Ticket[]                   @relation("TicketOwner")
  assignments              TicketAssignment[]
  approvals                TicketApproval[]
  comments                 TicketComment[]
  notifications            Notification[]
  invitationsSent          EmailInvitation[]          @relation("InvitationSender")
  invitationReceived       EmailInvitation?           @relation("InvitationReceiver")
  passwordResetTokens      PasswordResetToken[]
  companies                UserCompany[]
  auditLogs                AuditLog[]
  signupRequestsReviewed   SignupRequest[]
  tasksAssigned            TicketTask[]               @relation("TaskAssignee")
  tasksCreated             TicketTask[]               @relation("TaskCreator")
  statusChanges            TicketStatusHistory[]      @relation("StatusHistoryChanger")
  dependenciesCreated      TicketDependency[]         @relation("DependencyCreator")
  suitesOwned              TestSuite[]                @relation("SuiteOwner")
  suiteTicketLinks         TestSuiteTicket[]          @relation("SuiteTicketLinker")
  casesAssigned            TestCase[]                 @relation("CaseAssignee")
  casesRun                 TestCase[]                 @relation("CaseRunner")
  caseResultChanges        TestCaseResultHistory[]    @relation("CaseResultChanger")
  bugsReported             Bug[]                      @relation("BugReporter")
  bugsAssigned             Bug[]                      @relation("BugAssignee")
  bugStatusChanges         BugStatusHistory[]         @relation("BugStatusChanger")
  meetingsOrganized        Meeting[]                  @relation("MeetingOrganizer")
  meetingsAttended         MeetingAttendee[]          @relation("MeetingAttendeeUser")
  pointsRaised             MeetingPoint[]             @relation("PointRaiser")
  requirementsCreated      Requirement[]              @relation("RequirementCreator")
  requirementsRequested    Requirement[]              @relation("RequirementRequester")
  requirementsOwned        Requirement[]              @relation("RequirementOwner")
  requirementsDecided      Requirement[]              @relation("RequirementDecider")
  requirementStatusChanges RequirementStatusHistory[] @relation("RequirementStatusChanger")
  toolsRequested           Tool[]                     @relation("ToolRequester")
  toolsDecided             Tool[]                     @relation("ToolDecider")
  feedbackCreated          Feedback[]                 @relation("FeedbackAuthor")
  feedbackAssigned         Feedback[]                 @relation("FeedbackAssignee")
  hubGuidesCreated         HubGuide[]                 @relation("HubGuideAuthor")
  hubGuidesUpdated         HubGuide[]                 @relation("HubGuideEditor")
}

model UserSystem {
  userId    String
  systemId  String
  user      User     @relation(fields: [userId], references: [id])
  system    System   @relation(fields: [systemId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, systemId])
}

model Ticket {
  id                   String                @id @default(uuid())
  title                String
  description          String
  reason               String
  expectedOutcome      String
  businessImpact       String
  hasFinancialLoss     Boolean               @default(false)
  financialLossDetails String?
  status               TicketStatus          @default(DRAFT)
  type                 TicketType
  priority             Priority?
  finalPriority        Priority?
  suggestedDeadline    DateTime?
  scheduledStart       DateTime?
  estimatedDeadline    DateTime?
  estimatedHours       Int?
  difficultyLevel      Int?
  /// Rollups over this ticket's tasks. Single writer: TaskRollupService.
  tasksEstimatedHours  Int?
  tasksWeightTotal     Int?
  /// Stamped by changeStatus. startedAt is the first move into IN_PROGRESS and
  /// is never reset; completedAt clears if the ticket moves back out of COMPLETED.
  startedAt            DateTime?
  completedAt          DateTime?
  needsUiUx            Boolean               @default(false)
  needsBackend         Boolean               @default(false)
  needsFrontend        Boolean               @default(false)
  needsTesting         Boolean               @default(false)
  needsDeployment      Boolean               @default(false)
  adminNotes           String?
  closureNotes         String?
  isArchived           Boolean               @default(false)
  coverImageUrl        String?
  ticketNumber         Int                   @unique @default(autoincrement())
  creatorId            String
  creator              User                  @relation("TicketCreator", fields: [creatorId], references: [id])
  systemOwnerId        String?
  systemOwner          User?                 @relation("TicketOwner", fields: [systemOwnerId], references: [id])
  systemId             String
  system               System                @relation(fields: [systemId], references: [id])
  companyId            String
  company              Company               @relation(fields: [companyId], references: [id])
  relatedTicketId      String?
  relatedTicket        Ticket?               @relation("RelatedTickets", fields: [relatedTicketId], references: [id])
  relatedTickets       Ticket[]              @relation("RelatedTickets")
  /// Why the ticket is BLOCKED or ON_HOLD. Cleared on resume. The status to
  /// return to is read out of TicketStatusHistory rather than stored, so it
  /// cannot drift when force-status is used.
  pauseReason          String?
  blockedByTicketId    String?
  blockedByTicket      Ticket?               @relation("BlockedBy", fields: [blockedByTicketId], references: [id])
  blockedTickets       Ticket[]              @relation("BlockedBy")
  /// The requirement this ticket implements, set by "promote". One requirement
  /// may produce several tickets; the requirement itself moves to CONVERTED.
  requirementId        String?
  requirement          Requirement?          @relation("RequirementTickets", fields: [requirementId], references: [id])
  templateId           String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  comments             TicketComment[]
  attachments          TicketAttachment[]
  statusHistory        TicketStatusHistory[]
  assignments          TicketAssignment[]
  approvals            TicketApproval[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  tasks                TicketTask[]
  blocking             TicketDependency[]    @relation("BlockingTicket")
  blockedBy            TicketDependency[]    @relation("BlockedTicket")
  testCases            TestCase[]
  bugs                 Bug[]                 @relation("BugTicket")
  suiteLinks           TestSuiteTicket[]
}

/// "This ticket cannot start until that one is done."
///
/// Replaces Ticket.relatedTicketId, which said only "related" — no direction, no
/// meaning, and nothing read it. Edges are checked for cycles before they are
/// written, so the graph stays a DAG.
model TicketDependency {
  id               String               @id @default(uuid())
  blockingTicketId String
  blockingTicket   Ticket               @relation("BlockingTicket", fields: [blockingTicketId], references: [id], onDelete: Cascade)
  blockedTicketId  String
  blockedTicket    Ticket               @relation("BlockedTicket", fields: [blockedTicketId], references: [id], onDelete: Cascade)
  type             TicketDependencyType @default(BLOCKS)
  createdById      String
  createdBy        User                 @relation("DependencyCreator", fields: [createdById], references: [id])
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([blockingTicketId, blockedTicketId])
  @@index([blockedTicketId])
}

/// One thread shape for two parents: a ticket or a requirement. Exactly one of
/// ticketId / requirementId is ever set — `CommentParentRef` resolves which.
model TicketComment {
  id            String             @id @default(uuid())
  content       String
  visibility    CommentVisibility  @default(PUBLIC)
  ticketId      String?
  ticket        Ticket?            @relation(fields: [ticketId], references: [id])
  requirementId String?
  requirement   Requirement?       @relation(fields: [requirementId], references: [id])
  authorId      String
  author        User               @relation(fields: [authorId], references: [id])
  mentions      String[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  attachments   TicketAttachment[]
}

model TicketAttachment {
  id            String         @id @default(uuid())
  fileName      String
  fileSize      Int
  mimeType      String
  url           String
  ticketId      String?
  ticket        Ticket?        @relation(fields: [ticketId], references: [id])
  commentId     String?
  comment       TicketComment? @relation(fields: [commentId], references: [id])
  taskId        String?
  task          TicketTask?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  testCaseId    String?
  testCase      TestCase?      @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  bugId         String?
  bug           Bug?           @relation(fields: [bugId], references: [id], onDelete: Cascade)
  testStepId    String?
  testStep      TestStep?      @relation(fields: [testStepId], references: [id], onDelete: Cascade)
  /// Suite-level reference docs covering the whole suite (any file type).
  suiteId       String?
  suite         TestSuite?     @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  /// Meeting-level files — the agenda deck, a signed minutes PDF.
  meetingId     String?
  meeting       Meeting?       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  requirementId String?
  requirement   Requirement?   @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  uploadedById  String
  createdAt     DateTime       @default(now())
}

model TicketStatusHistory {
  id          String        @id @default(uuid())
  ticketId    String
  ticket      Ticket        @relation(fields: [ticketId], references: [id])
  fromStatus  TicketStatus?
  toStatus    TicketStatus
  changedById String
  changedBy   User          @relation("StatusHistoryChanger", fields: [changedById], references: [id])
  reason      String?
  createdAt   DateTime      @default(now())
}

/// Who is working a ticket. A membership row per developer, not an append-only
/// log — assignment history lives in AuditLog. Exactly one active row per ticket
/// carries isLead, enforced by a partial unique index.
model TicketAssignment {
  id                String    @id @default(uuid())
  ticketId          String
  ticket            Ticket    @relation(fields: [ticketId], references: [id])
  developerId       String
  developer         User      @relation(fields: [developerId], references: [id])
  estimatedHours    Int?
  startDate         DateTime?
  estimatedDeadline DateTime?
  isActive          Boolean   @default(true)
  /// The lead owns the ticket-level transitions; everyone else works their tasks.
  isLead            Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([ticketId, developerId])
  @@index([ticketId, isActive])
}

model TicketApproval {
  id         String   @id @default(uuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
  approverId String
  approver   User     @relation(fields: [approverId], references: [id])
  decision   String
  notes      String?
  conditions String?
  createdAt  DateTime @default(now())
}

model EmailInvitation {
  id         String           @id @default(uuid())
  email      String
  role       UserRole
  token      String           @unique @default(uuid())
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime
  senderId   String
  sender     User             @relation("InvitationSender", fields: [senderId], references: [id])
  receiverId String?          @unique
  receiver   User?            @relation("InvitationReceiver", fields: [receiverId], references: [id])
  companyId  String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model Notification {
  id            String           @id @default(uuid())
  type          NotificationType
  title         String
  body          String
  isRead        Boolean          @default(false)
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  ticketId      String?
  ticket        Ticket?          @relation(fields: [ticketId], references: [id])
  requirementId String?
  requirement   Requirement?     @relation(fields: [requirementId], references: [id])
  metadata      Json?
  createdAt     DateTime         @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  ticketId  String?
  ticket    Ticket?  @relation(fields: [ticketId], references: [id])
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model TicketTemplate {
  id          String     @id @default(uuid())
  name        String
  nameAr      String?
  domain      String?
  type        TicketType
  description String?
  fields      Json?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model UserCompany {
  userId    String
  companyId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, companyId])
}

model SignupRequest {
  id           String              @id @default(uuid())
  firstName    String
  lastName     String
  email        String              @unique
  status       SignupRequestStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?               @relation(fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  createdAt    DateTime            @default(now())
}

model TicketTask {
  id              String             @id @default(cuid())
  ticketId        String
  ticket          Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  assignedToId    String
  assignedTo      User               @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdById     String
  createdBy       User               @relation("TaskCreator", fields: [createdById], references: [id])
  status          TaskStatus         @default(NEW)
  /// Manual position inside the ticket's task list. Contiguous from 0,
  /// rebalanced on reorder and delete (mirrors MeetingPoint and TestStep).
  order           Int                @default(0)
  /// A blocking task gates everything under it: no task with a higher `order`
  /// may start or complete until this one is COMPLETED, so the list below a
  /// blocker runs top to bottom.
  isBlocking      Boolean            @default(false)
  dueDate         DateTime?
  estimatedHours  Int?
  /// 1–5, the same scale as Ticket.difficultyLevel (req.md §9 «مستوى الصعوبة»).
  difficultyLevel Int?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  attachments     TicketAttachment[]

  @@index([ticketId, status])
  @@index([ticketId, order])
  @@index([assignedToId, status])
}

/// A named group of test cases hanging off exactly one system, plus any number
/// of tickets it exercises. Scope (who may see it) comes from the system and
/// company, so the existing ticket scoping rules apply unchanged.
model TestSuite {
  id          String    @id @default(uuid())
  suiteNumber Int       @unique @default(autoincrement())
  title       String
  description String?
  systemId    String
  system      System    @relation(fields: [systemId], references: [id])
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  ownerId     String
  owner       User      @relation("SuiteOwner", fields: [ownerId], references: [id])
  state       TestState @default(DRAFT)
  isArchived  Boolean   @default(false)
  /// Rollup over this suite's ACTIVE cases. Single writer: TestRollupService.
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  cases       TestCase[]
  ticketLinks TestSuiteTicket[]
  bugs        Bug[]
  attachments TicketAttachment[]

  @@index([systemId, state])
  @@index([companyId])
}

/// "This suite exercises that ticket." A suite covering authentication links
/// both the backend and the frontend auth tickets.
model TestSuiteTicket {
  suiteId    String
  suite      TestSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  ticketId   String
  ticket     Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  linkedById String
  linkedBy   User      @relation("SuiteTicketLinker", fields: [linkedById], references: [id])
  createdAt  DateTime  @default(now())

  @@id([suiteId, ticketId])
  @@index([ticketId])
}

model TestCase {
  id             String     @id @default(uuid())
  caseNumber     Int        @unique @default(autoincrement())
  suiteId        String
  suite          TestSuite  @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  /// The one ticket this case is primarily about. The suite may link more.
  ticketId       String?
  ticket         Ticket?    @relation(fields: [ticketId], references: [id])
  assignedToId   String?
  assignedTo     User?      @relation("CaseAssignee", fields: [assignedToId], references: [id])
  title          String
  description    String?
  preconditions  String?
  expectedResult String
  actualResult   String?
  state          TestState  @default(DRAFT)
  lastResult     TestResult @default(NOT_RUN)
  lastRunAt      DateTime?
  lastRunById    String?
  lastRunBy      User?      @relation("CaseRunner", fields: [lastRunById], references: [id])
  /// Manual ordering inside the suite panel.
  order          Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  steps         TestStep[]              @relation("CaseSteps")
  bugs          Bug[]
  resultHistory TestCaseResultHistory[]
  /// Case-level files only — step screenshots hang off TestStep.attachments.
  attachments   TicketAttachment[]

  @@index([suiteId, order])
  @@index([ticketId])
  @@index([assignedToId, lastResult])
}

/// Ordered step row — shared shape for test-case execution steps and bug repro
/// steps. Exactly one of testCaseId / bugId is set. Attachments (typically
/// screenshots) belong to the step, not the parent case/bug.
model TestStep {
  id         String    @id @default(uuid())
  testCaseId String?
  testCase   TestCase? @relation("CaseSteps", fields: [testCaseId], references: [id], onDelete: Cascade)
  bugId      String?
  bug        Bug?      @relation("BugSteps", fields: [bugId], references: [id], onDelete: Cascade)
  order      Int       @default(0)
  body       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  attachments TicketAttachment[]

  @@index([testCaseId, order])
  @@index([bugId, order])
}

/// Mirrors TicketStatusHistory: every result change is auditable.
model TestCaseResultHistory {
  id          String      @id @default(uuid())
  testCaseId  String
  testCase    TestCase    @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  fromResult  TestResult?
  toResult    TestResult
  changedById String
  changedBy   User        @relation("CaseResultChanger", fields: [changedById], references: [id])
  note        String?
  createdAt   DateTime    @default(now())

  @@index([testCaseId, createdAt])
}

model Bug {
  id               String      @id @default(uuid())
  bugNumber        Int         @unique @default(autoincrement())
  /// Null when the bug was filed straight from the bugs page.
  testCaseId       String?
  testCase         TestCase?   @relation(fields: [testCaseId], references: [id])
  suiteId          String?
  suite            TestSuite?  @relation(fields: [suiteId], references: [id])
  /// Denormalised on purpose: a standalone bug has no case to inherit scope
  /// from, and the list page filters on both constantly.
  systemId         String
  system           System      @relation(fields: [systemId], references: [id])
  companyId        String
  company          Company     @relation(fields: [companyId], references: [id])
  /// Set by "promote to ticket".
  ticketId         String?
  ticket           Ticket?     @relation("BugTicket", fields: [ticketId], references: [id])
  reportedById     String
  reportedBy       User        @relation("BugReporter", fields: [reportedById], references: [id])
  assignedToId     String?
  assignedTo       User?       @relation("BugAssignee", fields: [assignedToId], references: [id])
  title            String
  description      String
  expectedBehavior String?
  actualBehavior   String?
  environment      String?
  severity         BugSeverity
  priority         Priority?
  status           BugStatus   @default(OPEN)
  detectedAt       DateTime    @default(now())
  resolvedAt       DateTime?
  isArchived       Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  steps         TestStep[]         @relation("BugSteps")
  attachments   TicketAttachment[]
  statusHistory BugStatusHistory[]

  @@index([status, severity])
  @@index([systemId])
  @@index([assignedToId, status])
  @@index([ticketId])
  @@index([testCaseId])
}

model BugStatusHistory {
  id          String     @id @default(uuid())
  bugId       String
  bug         Bug        @relation(fields: [bugId], references: [id], onDelete: Cascade)
  fromStatus  BugStatus?
  toStatus    BugStatus
  changedById String
  changedBy   User       @relation("BugStatusChanger", fields: [changedById], references: [id])
  note        String?
  createdAt   DateTime   @default(now())

  @@index([bugId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Meetings, minutes and requirements (MEETINGS_PLAN.md)
//
// A meeting is the event; its minutes are ordered MeetingPoint rows. A line
// that has to be *tracked* is captured as a Requirement, which is the backlog —
// there is deliberately no BACKLOG ticket status. Promoting a requirement
// creates a DRAFT ticket, so PROGRAMMING_HEAD approval is still the only door
// into development (req.md §8, §21).
// ─────────────────────────────────────────────────────────────────────────────

enum MeetingType {
  CEO_REVIEW
  KICKOFF
  FOLLOW_UP
  /// req.md §8 «تحويل لاجتماع نقاش» — a ticket sent to a discussion meeting.
  DISCUSSION
  RETROSPECTIVE
  OTHER
}

enum MeetingStatus {
  SCHEDULED
  HELD
  CANCELLED
}

/// What a minutes line *is*. Only REQUEST is normally captured, but the kind is
/// descriptive rather than a gate — a RISK worth tracking can be captured too.
enum PointKind {
  NOTE
  DECISION
  RISK
  REQUEST
}

/// Where the ask came in. MEETING is set by capture and carries meetingPointId;
/// everything else is a standalone requirement with a `sourceNote`.
enum RequirementSource {
  MEETING
  WHATSAPP
  EMAIL
  DOCUMENT
  CALL
  OTHER
}

enum RequirementStatus {
  NEW
  UNDER_REVIEW
  ACCEPTED
  /// Terminal: a ticket now carries the work. Set by promote, never by hand.
  CONVERTED
  DECLINED
}

/// One meeting, scoped to exactly one company and any number of its systems.
/// Minutes live in `points`; there is no free-text `minutes` column on purpose.
model Meeting {
  id            String        @id @default(uuid())
  meetingNumber Int           @unique @default(autoincrement())
  title         String
  /// The agenda, written before the meeting.
  description   String?
  type          MeetingType   @default(FOLLOW_UP)
  status        MeetingStatus @default(SCHEDULED)
  /// When it is (SCHEDULED) or was (HELD) held. Stamped on hold if still empty.
  heldAt        DateTime?
  durationMins  Int?
  location      String?
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  organizerId   String
  organizer     User          @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  isArchived    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  attendees   MeetingAttendee[]
  systems     MeetingSystem[]
  points      MeetingPoint[]
  attachments TicketAttachment[]

  @@index([companyId, status])
  @@index([heldAt])
}

/// Who was in the room. `userId` for an internal account; the free-text trio for
/// an external guest (a group CEO has no login and should not need one).
model MeetingAttendee {
  id           String   @id @default(uuid())
  meetingId    String
  meeting      Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?    @relation("MeetingAttendeeUser", fields: [userId], references: [id])
  name         String?
  jobTitle     String?
  organization String?
  createdAt    DateTime @default(now())

  /// Postgres allows repeated NULLs, so this blocks a duplicate internal
  /// attendee without limiting how many externals a meeting may have.
  @@unique([meetingId, userId])
  @@index([meetingId])
}

/// "This meeting covered that system." Scope stays on the company; the systems
/// are what the discussion was about.
model MeetingSystem {
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  systemId  String
  system    System   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([meetingId, systemId])
  @@index([systemId])
}

/// One numbered line of the minutes. Deliberately thin — no status, no number of
/// its own, no comment thread. A line that needs any of those is captured as a
/// Requirement instead.
model MeetingPoint {
  id           String    @id @default(uuid())
  meetingId    String
  meeting      Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  /// Contiguous from 0, rebalanced on reorder and delete (mirrors TestStep).
  order        Int       @default(0)
  kind         PointKind @default(NOTE)
  body         String
  raisedById   String?
  raisedBy     User?     @relation("PointRaiser", fields: [raisedById], references: [id])
  /// Whoever raised it has no account — «الرئيس التنفيذي».
  raisedByName String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  requirements Requirement[]

  @@index([meetingId, order])
}

/// A tracked ask, from a meeting line or from anywhere else. This is the
/// backlog: it lives here until leadership pins it to a system and promotes it
/// into a DRAFT ticket.
model Requirement {
  id                String            @id @default(uuid())
  requirementNumber Int               @unique @default(autoincrement())
  title             String
  description       String?
  source            RequirementSource @default(MEETING)
  /// Where it came in, when there is no meeting point — «واتساب من م. أحمد».
  sourceNote        String?
  meetingPointId    String?
  meetingPoint      MeetingPoint?     @relation(fields: [meetingPointId], references: [id])
  status            RequirementStatus @default(NEW)
  priority          Priority?
  /// Who asked. `requestedByName` covers an external requester with no account.
  requestedById     String?
  requestedBy       User?             @relation("RequirementRequester", fields: [requestedById], references: [id])
  requestedByName   String?
  /// Who is chasing it inside the programming team.
  ownerId           String?
  owner             User?             @relation("RequirementOwner", fields: [ownerId], references: [id])
  dueDate           DateTime?
  /// Null until triage pins it. Promote refuses while it is null, and an
  /// unpinned requirement is invisible to non-leadership.
  systemId          String?
  system            System?           @relation(fields: [systemId], references: [id])
  companyId         String
  company           Company           @relation(fields: [companyId], references: [id])
  /// Who filed it here — not necessarily who asked for it.
  createdById       String
  createdBy         User              @relation("RequirementCreator", fields: [createdById], references: [id])
  decidedById       String?
  decidedBy         User?             @relation("RequirementDecider", fields: [decidedById], references: [id])
  decidedAt         DateTime?
  decisionNote      String?
  isArchived        Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tickets       Ticket[]                   @relation("RequirementTickets")
  comments      TicketComment[]
  attachments   TicketAttachment[]
  statusHistory RequirementStatusHistory[]
  notifications Notification[]

  @@index([companyId, status])
  @@index([systemId, status])
  @@index([meetingPointId])
  @@index([ownerId, status])
}

/// Mirrors BugStatusHistory: every status move on a requirement is auditable.
model RequirementStatusHistory {
  id            String             @id @default(uuid())
  requirementId String
  requirement   Requirement        @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  fromStatus    RequirementStatus?
  toStatus      RequirementStatus
  changedById   String
  changedBy     User               @relation("RequirementStatusChanger", fields: [changedById], references: [id])
  note          String?
  createdAt     DateTime           @default(now())

  @@index([requirementId, createdAt])
}

/// Where a tool sits in the dev section's kit. The only tag in v1 — role and
/// project tags can be added later without moving anything that exists.
enum ToolCategory {
  AI_CODING
  TESTING
  DESIGN
  DEPLOYMENT
  MONITORING
  DATABASE
  COMMUNICATION
  SECURITY
  OTHER
}

/// A tool is REQUESTED until leadership rules on it. DECLINED rows stay on the
/// board with their reason: dropping them is what makes the same suggestion
/// come back every few months. RETIRED mirrors the archive-never-delete rule
/// tickets follow.
enum ToolStatus {
  REQUESTED
  APPROVED
  DECLINED
  RETIRED
}

/// Who the tool is for. A tool can target more than one team.
enum ToolTeam {
  FRONTEND
  BACKEND
  MOBILE
  QA
  PROJECT_MANAGEMENT
}

/// A tool the dev section uses, or has been asked to use.
///
/// Not scoped to a company or a system: the kit is the same whichever project
/// a developer is on, which is the whole point of keeping one catalogue.
model Tool {
  id             String         @id @default(uuid())
  name           String
  website        String
  description    String
  /// Three or four lines on getting started. Markdown, rendered read-only.
  gettingStarted String
  categories     ToolCategory[]
  /// Frontend / backend / mobile / QA / PM — who should care about this tool.
  teams          ToolTeam[]
  status         ToolStatus     @default(REQUESTED)

  requestedById String
  requestedBy   User   @relation("ToolRequester", fields: [requestedById], references: [id])

  decidedById  String?
  decidedBy    User?     @relation("ToolDecider", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  /// Why it was declined or retired. Required on decline.
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([requestedById])
}

/// Improvement, complaint, or inquiry. Not a ticket: no company/system, and a
/// salary question must not appear on a public board. Visibility is the author,
/// the named responsible person, and leadership.
enum FeedbackKind {
  IMPROVEMENT
  COMPLAINT
  INQUIRY
}

enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Feedback {
  id               String         @id @default(uuid())
  title            String
  body             String
  kind             FeedbackKind
  status           FeedbackStatus @default(OPEN)
  /// Optional. What the author would do about it.
  proposedSolution String?
  /// Optional. What was done, or why it was closed.
  resolutionNote   String?

  createdById String
  createdBy   User @relation("FeedbackAuthor", fields: [createdById], references: [id])

  /// Null means general — leadership's inbox, not a named person.
  assigneeId String?
  assignee   User?   @relation("FeedbackAssignee", fields: [assigneeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([kind])
  @@index([createdById])
  @@index([assigneeId])
}

/// Company-wide workflow rules shown on the hub's «دورة العمل» tab.
/// Not company-scoped: one ordered list for every SANAM system and project.
model HubGuide {
  id        String   @id @default(uuid())
  title     String
  summary   String
  steps     String[]
  sortOrder Int      @default(0)

  createdById String?
  createdBy   User?   @relation("HubGuideAuthor", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("HubGuideEditor", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}
